# Copy to agent/.env and fill in. Never commit .env.
OPENAI_API_KEY=
# Pick a current model from the OpenAI docs (models page), e.g. a small, cheap one for the agent.
OPENAI_MODEL=
# Only needed for the bylaw lookup (RAG) step.
OPENAI_EMBED_MODEL=
# Pinned "today" so rankings don't change from run to run.
AS_OF=2026-10-03
# Comma-separated frontend URLs allowed to call the API.
CORS_ORIGINS=http://localhost:5173
